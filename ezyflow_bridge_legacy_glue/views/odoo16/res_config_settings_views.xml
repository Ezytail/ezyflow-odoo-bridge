<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The Odoo 16 twin of views/res_config_settings_views.xml: the same view
         and xml id on 16's settings markup (a heading per block). -->
    <record id="res_config_settings_view_form_ezyflow_legacy_glue" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ezyflow.legacy.glue</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ezyflow_bridge.res_config_settings_view_form_ezyflow" />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='ezyflow_bridge']/h2[text()='Connector']" position="before">
                <div class="alert alert-info" role="alert">
                    The legacy logistics module is installed: it decides which transfers are
                    offered to the WMS, their channel, their hold and their backorders, and
                    its WMS constraints apply. The EzyFlow logistics mode reads off on every
                    operation type and the EzyFlow constraints below are switched off.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
