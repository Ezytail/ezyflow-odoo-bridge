<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 18 has no privilege: a group hangs on its module category. -->
    <record id="group_ezyflow_connector" model="res.groups">
        <field name="category_id" ref="module_category_ezyflow" />
        <!-- api_key_duration lets an administrator mint a ten-year API key
             through Odoo's own API-key screen (ADR 0013); the field exists from
             Odoo 17, so each series folder from 18 writes it. -->
        <field name="api_key_duration">3650</field>
    </record>
</odoo>
