<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 19 and 20 group the access rights of Settings by privilege; the
         privilege hangs on the module category of the common file. -->
    <record model="res.groups.privilege" id="res_groups_privilege_ezyflow">
        <field name="name">EzyFlow</field>
        <field name="category_id" ref="module_category_ezyflow" />
    </record>
    <record id="group_ezyflow_connector" model="res.groups">
        <field name="privilege_id" ref="res_groups_privilege_ezyflow" />
        <!-- api_key_duration lets an administrator mint a ten-year API key
             through Odoo's own API-key screen (ADR 0013); the field exists from
             Odoo 17, so each series folder from 18 writes it. -->
        <field name="api_key_duration">3650</field>
    </record>
</odoo>
