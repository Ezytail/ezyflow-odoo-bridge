<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 16 has no privilege: a group hangs on its module category. A key
         carries no expiry on 16 (ADR 0013 holds from 17), so no duration here. -->
    <record id="group_ezyflow_connector" model="res.groups">
        <field name="category_id" ref="module_category_ezyflow" />
    </record>
</odoo>
