<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_ezyflow" model="ir.ui.view">
        <field name="name">sale.order.form.ezyflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//field[@name='team_id']" position="after">
                <field name="ezy_channel" />
                <field name="ezy_final_recipient_id" />
                <field name="ezy_shop_total" />
                <field name="ezy_total_differs" invisible="1" />
            </xpath>
            <!-- Behaviour 12: the shop total differs from Odoo's; a person checks
                 the taxes and the fiscal position, the order stands. The two
                 fields below are shown a second time on purpose, read-only: the
                 editable shop total lives in the Other information tab above. -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not ezy_total_differs">
                    The shop collected
                    <field name="ezy_shop_total" readonly="1" class="oe_inline" />
                    for this order while its total here is
                    <field name="amount_total" readonly="1" class="oe_inline" />:
                    check the taxes and the fiscal position.
                </div>
            </xpath>
        </field>
    </record>

    <!-- The delivery status already shows the WMS values through the extended
         selection; the list colours the two the sales team acts on. -->
    <record id="view_order_tree_ezyflow" model="ir.ui.view">
        <field name="name">sale.order.list.ezyflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_status']" position="attributes">
                <attribute name="decoration-danger">delivery_status in ('refused_by_logistics', 'cancelled_by_logistics')</attribute>
                <attribute name="decoration-success">delivery_status in ('full', 'shipped')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Behaviour 7: one click groups the orders by delivery status, which
         carries the WMS values once a transfer is in the hand-off. -->
    <record id="view_sales_order_filter_ezyflow" model="ir.ui.view">
        <field name="name">sale.order.search.ezyflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <filter name="order_month" position="after">
                <filter string="Delivery Status" name="ezy_delivery_status" context="{'group_by': 'delivery_status'}" />
            </filter>
        </field>
    </record>
</odoo>
