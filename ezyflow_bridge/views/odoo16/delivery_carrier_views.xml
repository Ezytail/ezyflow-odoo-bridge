<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The Odoo 16 twin of views/delivery_carrier_views.xml (ADR 0015, ADR 0035): the same
         views and xml ids, the modifiers in the attrs syntax 16 reads; loaded
         by the series loader on 16 only. Change the shared file and this one
         together (the twin test checks the xml ids). -->
    <record id="view_delivery_carrier_form_ezyflow" model="ir.ui.view">
        <field name="name">delivery.carrier.form.ezyflow</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_type']" position="after">
                <field name="ezy_service_code" />
                <field name="ezy_carrier_code" />
                <field name="ezy_has_relay_points" />
            </xpath>
        </field>
    </record>
</odoo>
