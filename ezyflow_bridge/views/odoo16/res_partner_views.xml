<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The Odoo 16 twin of views/res_partner_views.xml (ADR 0015, ADR 0035): the same
         views and xml ids, the modifiers in the attrs syntax 16 reads; loaded
         by the series loader on 16 only. Change the shared file and this one
         together (the twin test checks the xml ids). -->
    <record id="view_partner_form_ezyflow" model="ir.ui.view">
        <field name="name">res.partner.form.ezyflow</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="inside">
                <field name="ezy_channel" />
                <field name="ezy_relay_code" />
                <field name="ezy_company_partner" groups="base.group_system" />
                <field name="ezy_relay_carrier_id" attrs="{'invisible': [('ezy_relay_code', '=', False)]}" />
            </xpath>
        </field>
    </record>
</odoo>
