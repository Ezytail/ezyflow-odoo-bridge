<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The Odoo 16 twin of views/stock_picking_type_views.xml (ADR 0015, ADR 0035): the same
         views and xml ids, the modifiers in the attrs syntax 16 reads; loaded
         by the series loader on 16 only. Change the shared file and this one
         together (the twin test checks the xml ids). -->
    <record id="view_picking_type_form_ezyflow" model="ir.ui.view">
        <field name="name">stock.picking.type.form.ezyflow</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="ezy_logistics_mode" widget="radio" attrs="{'invisible': [('code', '=', 'internal')]}" />
                <field
                    name="ezy_channels"
                    placeholder="e.g. WEB,PRO (empty: every channel)"
                    attrs="{'invisible': ['|', ('code', '=', 'internal'), ('ezy_logistics_mode', '=', 'off')]}"
                />
            </field>
        </field>
    </record>
</odoo>
