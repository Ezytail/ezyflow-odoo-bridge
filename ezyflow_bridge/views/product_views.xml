<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_ezyflow" model="ir.ui.view">
        <field name="name">product.template.form.ezyflow</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="ezy_shop_product_id" />
            </xpath>
            <!-- ADR 0034: under Odoo's Traceability group (stock, 19 and 20),
                 shown only for a product tracked by lots or serial numbers.
                 Odoo 18 keeps that group hidden: views/odoo18/ moves the field
                 next to the tracking choice there (ADR 0015, the series loader). -->
            <xpath expr="//group[@name='traceability']" position="inside">
                <field name="tracking" invisible="1" />
                <field
                    name="ezy_rotation_date_type"
                    invisible="tracking not in ('lot', 'serial')"
                />
            </xpath>
        </field>
    </record>
    <record id="product_normal_form_view_ezyflow" model="ir.ui.view">
        <field name="name">product.product.form.ezyflow</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="ezy_shop_variant_id" />
            </xpath>
        </field>
    </record>
</odoo>
