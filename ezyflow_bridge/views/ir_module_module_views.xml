<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        The bridge help page (ADR 0030): Odoo renders static/description/index.html
        as the module's description, and the Help block of the EzyFlow settings
        page opens the bridge's module record in a dialog on this form view, which
        shows that description and nothing else. No header (the module form's
        Upgrade and Uninstall buttons stay in Apps), no tabs.
    -->
    <record id="ir_module_module_view_form_ezyflow_help" model="ir.ui.view">
        <field name="name">ir.module.module.form.ezyflow.help</field>
        <field name="model">ir.module.module</field>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <form string="EzyFlow bridge help" create="0" edit="0" delete="0">
                <sheet>
                    <field name="description_html" nolabel="1" readonly="1" />
                </sheet>
            </form>
        </field>
    </record>

    <!-- The bridge's own module row: res_id is looked up when the data is
         loaded, so the form opens on the record instead of on a new one. -->
    <record id="action_ezyflow_bridge_help" model="ir.actions.act_window">
        <field name="name">EzyFlow bridge help</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ir_module_module_view_form_ezyflow_help" />
        <field name="res_id" model="ir.module.module" search="[('name', '=', 'ezyflow_bridge')]" />
        <field name="domain">[("name", "=", "ezyflow_bridge")]</field>
        <field name="target">new</field>
    </record>
</odoo>
