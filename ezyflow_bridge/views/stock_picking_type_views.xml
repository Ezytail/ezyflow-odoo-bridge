<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_type_form_ezyflow" model="ir.ui.view">
        <field name="name">stock.picking.type.form.ezyflow</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="ezy_logistics_mode" widget="radio" invisible="code == 'internal'" />
                <field
                    name="ezy_channels"
                    placeholder="e.g. WEB,PRO (empty: every channel)"
                    invisible="code == 'internal' or ezy_logistics_mode == 'off'"
                />
            </field>
        </field>
    </record>
</odoo>
