<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        The EzyFlow page of the Settings, the one place an administrator
        configures the bridge (ADR 0020): the Help block opens the bridge help
        page (ADR 0030); the Connector block shows the three
        wake-up keys (ADR 0006), database-wide system parameters, the secret
        behind the password widget; one setting per WMS constraint (ADR 0017),
        Apply stock reports (ADR 0018) and the proforma report (ADR 0016) are
        fields of the current company. Written to the settings form both series
        share (ADR 0015): an <app> inside the base form, its <block> and
        <setting> elements.
    -->
    <record id="res_config_settings_view_form_ezyflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ezyflow</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="EzyFlow"
                    string="EzyFlow"
                    name="ezyflow_bridge"
                    logo="/ezyflow_bridge/static/description/icon.png"
                >
                    <!-- The bridge help page (ADR 0030), first: the one document for
                         the administrator, shown here and from Apps. No setting. -->
                    <block
                        title="Help"
                        name="ezy_help"
                        help="How to configure the bridge and what people meet on Odoo's screens, in one page."
                    >
                        <setting
                            id="ezy_help"
                            string="EzyFlow bridge help"
                            help="The same page is shown from Apps, on the EzyFlow bridge module."
                        >
                            <button
                                name="%(action_ezyflow_bridge_help)d"
                                type="action"
                                string="Open the EzyFlow bridge help"
                                class="btn-link"
                                icon="oi-arrow-right"
                            />
                        </setting>
                    </block>
                    <block
                        title="Connector"
                        name="ezy_connector"
                        help="How Odoo wakes the EzyFlow connector up when a transfer is ready for logistics. One set for the whole database, whichever company is selected."
                    >
                        <setting id="ezy_activity" help="The activity this Odoo belongs to on the EzyFlow platform.">
                            <field name="ezy_activity" />
                        </setting>
                        <setting id="ezy_wakeup_url" help="The connector's wake-up endpoint, https://&lt;connector&gt;/wake-up.">
                            <field name="ezy_wakeup_url" />
                        </setting>
                        <setting id="ezy_wakeup_secret" help="The secret the wake-ups are signed with, the value the publication's odoo_wakeup_secret points to. Cleared, every wake-up is refused and the connector polls on its interval only.">
                            <field name="ezy_wakeup_secret" password="True" />
                        </setting>
                    </block>
                    <block
                        title="WMS constraints"
                        name="ezy_wms_constraints"
                        help="What a person saves or confirms is refused when the WMS would refuse it later. The connector user is never bound: an order from a shop lands as the shop sent it."
                    >
                        <setting id="ezy_wms_default_code_length" help="Refuse an internal reference longer than 16 characters.">
                            <field name="ezy_wms_default_code_length" />
                        </setting>
                        <setting id="ezy_wms_default_code_alphabet" help="Refuse an internal reference with a character other than A-Z 0-9 _ . - #.">
                            <field name="ezy_wms_default_code_alphabet" />
                        </setting>
                        <setting id="ezy_wms_default_code_unique" help="Refuse an internal reference another active product already holds, whatever its case.">
                            <field name="ezy_wms_default_code_unique" />
                        </setting>
                        <setting id="ezy_wms_default_code_required" help="Refuse a sellable good without internal reference.">
                            <field name="ezy_wms_default_code_required" />
                        </setting>
                        <setting id="ezy_wms_product_name_length" help="Refuse a product name longer than 30 characters.">
                            <field name="ezy_wms_product_name_length" />
                        </setting>
                        <setting id="ezy_wms_barcode_alphabet" help="Refuse a barcode with a character other than a letter or a digit.">
                            <field name="ezy_wms_barcode_alphabet" />
                        </setting>
                        <setting id="ezy_wms_barcode_length" help="Refuse a barcode longer than 35 characters.">
                            <field name="ezy_wms_barcode_length" />
                        </setting>
                        <setting id="ezy_wms_partner_name_length" help="Refuse a contact or address name longer than 35 characters.">
                            <field name="ezy_wms_partner_name_length" />
                        </setting>
                        <setting id="ezy_wms_street_length" help="Refuse a street or a street 2 longer than 35 characters.">
                            <field name="ezy_wms_street_length" />
                        </setting>
                        <setting id="ezy_wms_city_length" help="Refuse a city longer than 35 characters.">
                            <field name="ezy_wms_city_length" />
                        </setting>
                        <setting id="ezy_wms_zip_length" help="Refuse a postcode longer than 9 characters.">
                            <field name="ezy_wms_zip_length" />
                        </setting>
                        <setting id="ezy_wms_phone_length" help="Refuse a phone longer than 20 characters.">
                            <field name="ezy_wms_phone_length" />
                        </setting>
                        <setting id="ezy_wms_email_length" help="Refuse an email longer than 140 characters.">
                            <field name="ezy_wms_email_length" />
                        </setting>
                        <setting id="ezy_wms_delivery_contact_required" help="Refuse to confirm a sales order whose delivery address has no phone or no email.">
                            <field name="ezy_wms_delivery_contact_required" />
                        </setting>
                        <setting id="ezy_wms_picking_name" help="Refuse a receipt or delivery type in logistics mode whose next transfer reference would be longer than 20 characters, or use a character other than A-Z 0-9 _ - . # / and the backslash.">
                            <field name="ezy_wms_picking_name" />
                        </setting>
                    </block>
                    <block title="Stock" name="ezy_stock">
                        <setting id="ezy_apply_stock_reports" help="Apply the figures of a WMS stock report to the quantities on hand. Off, they are written as pending counts to review and apply from the physical inventory, and Odoo republishes nothing for the report. WMS movements are always applied.">
                            <field name="ezy_apply_stock_reports" />
                        </setting>
                    </block>
                    <block title="Documents" name="ezy_documents">
                        <setting id="ezy_proforma_report_id" help="The sales order report the connector renders as the proforma of this company's orders and forwards to the WMS for shipment paperwork. Empty, Odoo's pro forma invoice.">
                            <field name="ezy_proforma_report_id" options="{'no_create': True, 'no_open': True}" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
