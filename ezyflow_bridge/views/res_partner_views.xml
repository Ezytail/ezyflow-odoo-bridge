<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_ezyflow" model="ir.ui.view">
        <field name="name">res.partner.form.ezyflow</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="inside">
                <field name="ezy_channel" />
                <field name="ezy_relay_code" />
                <field name="ezy_relay_carrier_id" invisible="not ezy_relay_code" />
            </xpath>
        </field>
    </record>
</odoo>
