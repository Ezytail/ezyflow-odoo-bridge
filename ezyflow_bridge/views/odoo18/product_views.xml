<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 18 keeps the product form's Traceability group hidden
         (invisible="1") and shows the tracking choice on the General
         Information page: the rotation date type follows it there. Loaded by
         the series loader on 18 only (ADR 0015). -->
    <record id="product_template_form_view_ezyflow_odoo18" model="ir.ui.view">
        <field name="name">product.template.form.ezyflow.odoo18</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="ezyflow_bridge.product_template_form_view_ezyflow" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='tracking']" position="after">
                <xpath expr="//field[@name='ezy_rotation_date_type']" position="move" />
            </xpath>
        </field>
    </record>
</odoo>
