<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Wake-up parameters (ADR 0006). All three are set by the administrator
        after installation, in the Connector block of the EzyFlow settings page
        (ADR 0020); the bridge ships them empty so they exist.

        ezyflow.activity       the activity this Odoo belongs to on the platform
        ezyflow.wakeup_url     the connector's wake-up endpoint
        ezyflow.wakeup_secret  the HMAC-SHA256 secret shared with the connector
    -->
    <record id="param_ezyflow_activity" model="ir.config_parameter">
        <field name="key">ezyflow.activity</field>
        <field name="value"></field>
    </record>
    <record id="param_ezyflow_wakeup_url" model="ir.config_parameter">
        <field name="key">ezyflow.wakeup_url</field>
        <field name="value"></field>
    </record>
    <record id="param_ezyflow_wakeup_secret" model="ir.config_parameter">
        <field name="key">ezyflow.wakeup_secret</field>
        <field name="value"></field>
    </record>
</odoo>
