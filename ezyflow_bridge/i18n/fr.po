msgid ""
"Refuse an internal reference another active product already holds, whatever "
"its case."
msgstr ""
"Refuser une référence interne qu'un autre produit actif détient déjà, quelle"
" que soit sa casse."

#. module: ezyflow_bridge
#: model:ir.model.fields,help:ezyflow_bridge.field_res_company__ezy_wms_default_code_unique
#: model:ir.model.fields,help:ezyflow_bridge.field_res_config_settings__ezy_wms_default_code_unique
msgid ""
"Refuse an internal reference another active product of the company, or a "
"product shared by every company, already holds, compared without regard to "
"case: Reflex keeps one article per SKU and would merge the two."
msgstr ""
"Refuser une référence interne qu'un autre produit actif de la société, ou un"
" produit partagé par toutes les sociétés, détient déjà, comparée sans tenir "
"compte de la casse : Reflex ne garde qu'un article par SKU et fusionnerait "
"les deux."

#. module: ezyflow_bridge
#: model:ir.model.fields,help:ezyflow_bridge.field_res_company__ezy_wms_default_code_length
#: model:ir.model.fields,help:ezyflow_bridge.field_res_config_settings__ezy_wms_default_code_length
