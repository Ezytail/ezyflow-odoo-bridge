#. module: ezyflow_bridge
#: model:res.groups,comment:ezyflow_bridge.group_ezyflow_connector
msgid ""
"\n"
"            Technical user a publication of the EzyFlow connector acts as. Holder of\n"
"            the long-dated API key the portal stores as the publication's secret.\n"
"        "
msgstr ""
"\n"
"            Utilisateur technique au nom duquel agit une publication du connecteur EzyFlow. Détenteur\n"
"            de la clé API de longue durée que le portail conserve comme secret de la publication.\n"
"        "

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/product_product.py:0
msgid ""
"%(field)s %(value)s of %(product)s is already used by %(holder)s; the WMS "
"keeps one product per reference."
msgstr ""
"%(field)s %(value)s de %(product)s est déjà utilisé par %(holder)s ; le WMS "
"ne garde qu'un produit par référence."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/stock_picking_type.py:0
msgid ""
"%(field)s of %(name)s would give its next transfer the reference "
"%(example)s; the WMS accepts at most %(limit)s characters of %(alphabet)s. "
"Shorten the sequence prefix or turn the logistics mode off."
msgstr ""
"%(field)s de %(name)s donnerait à son prochain transfert la référence "
"%(example)s ; le WMS accepte au plus %(limit)s caractères parmi "
"%(alphabet)s. Raccourcissez le préfixe de la séquence ou désactivez le mode "
"logistique."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/res_partner.py:0
msgid ""
"%(field)s of %(partner)s is longer than %(limit)s characters, the most the "
"WMS accepts."
msgstr ""
"%(field)s de %(partner)s dépasse %(limit)s caractères, le maximum que le WMS"
" accepte."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/product_product.py:0
#: code:addons/ezyflow_bridge/models/product_template.py:0
msgid ""
"%(field)s of %(product)s is longer than %(limit)s characters, the most the "
"WMS accepts."
msgstr ""
"%(field)s de %(product)s dépasse %(limit)s caractères, le maximum que le WMS"
" accepte."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/product_product.py:0
msgid ""
"%(field)s of %(product)s, %(value)s, has a character the WMS refuses: only "
"%(alphabet)s are accepted."
msgstr ""
"%(field)s de %(product)s, %(value)s, contient un caractère que le WMS refuse"
" : seuls %(alphabet)s sont acceptés."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/product_product.py:0
msgid ""
"%(field)s of %(product)s, %(value)s, has a character the WMS refuses: only "
"letters and digits are accepted."
msgstr ""
"%(field)s de %(product)s, %(value)s, contient un caractère que le WMS refuse"
" : seuls les lettres et les chiffres sont acceptés."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/sale_order.py:0
msgid ""
"%(order)s cannot be confirmed: its delivery address %(partner)s has no "
"%(field)s, and the WMS requires a phone and an email on the delivery "
"address."
msgstr ""
"%(order)s ne peut pas être confirmée : son adresse de livraison %(partner)s "
"n'a pas de %(field)s, et le WMS exige un téléphone et un e-mail sur "
"l'adresse de livraison."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/stock_picking.py:0
msgid ""
"%(picking)s is frozen: its WMS state is '%(state)s', so its lines belong to "
"the WMS. Only the EzyFlow connector or an administrator may change them."
msgstr ""
"%(picking)s est gelé : son état WMS est « %(state)s », ses lignes "
"appartiennent donc au WMS. Seul le connecteur EzyFlow ou un administrateur "
"peut les modifier."

#. module: ezyflow_bridge
#. odoo-python
#: code:addons/ezyflow_bridge/models/product_product.py:0
msgid ""
"%(product)s is sold as goods and has no internal reference; the WMS "
"identifies products by it (%(field)s is required)."
msgstr ""
"%(product)s est vendu comme marchandise et n'a pas de référence interne ; le"
" WMS identifie les produits par elle (%(field)s est obligatoire)."

