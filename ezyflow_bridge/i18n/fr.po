#: model_terms:ir.ui.view,arch_db:ezyflow_bridge.res_config_settings_view_form_ezyflow
msgid "Refuse an internal reference longer than 16 characters."
msgstr "Refuser une référence interne de plus de 16 caractères."

#. module: ezyflow_bridge
#: model_terms:ir.ui.view,arch_db:ezyflow_bridge.res_config_settings_view_form_ezyflow
msgid ""
"Refuse an internal reference with a character other than A-Z 0-9 _ . - #."
msgstr ""
"Refuser une référence interne contenant un caractère autre que A-Z 0-9 _ . -"
" #."

#. module: ezyflow_bridge
#: model:ir.model.fields,help:ezyflow_bridge.field_res_company__ezy_wms_default_code_alphabet
#: model:ir.model.fields,help:ezyflow_bridge.field_res_config_settings__ezy_wms_default_code_alphabet
